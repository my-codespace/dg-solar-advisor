# SunSwitch Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git (it's in .gitignore).

# API Gateway base URL from SAM deploy output (no trailing slash)
VITE_API_BASE=https://YOUR_API_GATEWAY_ID.execute-api.ap-south-1.amazonaws.com/dev

# For local SAM development (sam local start-api):
# VITE_API_BASE=http://localhost:3000
